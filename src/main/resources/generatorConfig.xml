<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration
        PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">

<generatorConfiguration>
    <context id="DB2Tables" targetRuntime="MyBatis3">

        <jdbcConnection driverClass="com.mysql.cj.jdbc.Driver"
                        connectionURL="jdbc:mysql://118.89.93.131:3306/labor_dispatch"
                        userId="root"
                        password="123456"/>

        <!-- 实体类生成位置 -->
        <javaModelGenerator targetPackage="com.taoye.labor_dispatch.entity"
                            targetProject="src/main/java"/>

        <!-- Mapper XML -->
        <sqlMapGenerator targetPackage="mapper"
                         targetProject="src/main/resources"/>

        <!-- Mapper 接口 -->
        <javaClientGenerator type="XMLMAPPER"
                             targetPackage="com.taoye.labor_dispatch.mapper"
                             targetProject="src/main/java"/>

        <!-- 表配置 -->
        <table tableName="intial_description" domainObjectName="IntialDescription"/>
        <!--<table tableName="user_info" domainObjectName="UserInfo"/>-->
        <!--<table tableName="tag_user_info_ref" domainObjectName="TagUserInfoRef"/>-->
        <!--<table tableName="tag_description_ref" domainObjectName="TagDescriptionRef"/>-->
